{
  "name": "token",
  "productName": "Token",
  "version": "0.2.1",
  "private": true,
  "description": "Token 用量监控 — Hermes / Codex / Antigravity / Grok",
  "main": "dist/main/main.js",
  "author": "aluzzz",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "snapshot": "node scripts/make-snapshot.mjs",
    "start": "electron .",
    "dev": "vite",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run snapshot && npm run build && electron-builder --win --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tokscale": "^4.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "com.aluzzz.token",
    "productName": "Token",
    "publish": [
      {
        "provider": "github",
        "owner": "buyaowangji661-hash",
        "repo": "Token"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pricing-snapshot.json.gz",
        "to": "pricing-snapshot.json.gz"
      }
    ],
    "asarUnpack": [
      "node_modules/tokscale/**/*",
      "node_modules/@tokscale/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "Token"
    }
  }
}
